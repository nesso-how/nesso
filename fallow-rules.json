{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.32.0/rule-pack-schema.json",
  "version": 1,
  "name": "nesso",
  "rules": [
    {
      "id": "react-flow-isolation",
      "kind": "banned-import",
      "specifiers": ["@xyflow/react"],
      "exclude": ["packages/concept-map/**"],
      "message": "Keep React Flow imports in packages/concept-map.",
      "severity": "error"
    }
  ]
}
