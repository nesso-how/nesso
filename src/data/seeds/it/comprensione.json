  "name": "Comprensione",
  "concepts": [
    {
      "id": "n1",
      "label": "Comprensione",
      "x": 330,
      "y": 200,
      "data": {
        "elaboration": {
          "definition": "La costruzione attiva di senso: collegare idee, spiegare perché le cose funzionano e organizzare ciò che sai in una struttura coerente, non il semplice possesso di fatti isolati.",
          "notes": {
            "type": "doc",
            "content": [
              {
                "type": "callout",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Prova a spiegarlo a qualcuno senza guardare gli appunti."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "example",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Esempio: dopo un capitolo, ridisegna il suo argomento come un piccolo grafo a memoria."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "n2",
      "label": "Padronanza",
      "x": 340,
      "y": 40,
      "data": {
        "elaboration": {
          "definition": "Competenza dimostrata: saper applicare, eseguire o risolvere in modo affidabile nel contesto, oltre al saper dire che qualcosa è vero."
        }
      }
    },
    {
      "id": "n3",
      "label": "Conoscenza",
      "x": 600,
      "y": 110,
      "data": {
        "elaboration": {
          "definition": "Ciò che tieni per vero o sai enunciare: fatti, definizioni, proposizioni e informazioni accumulate nel tempo."
        }
      }
    },
    {
      "id": "n4",
      "label": "Indagine",
      "x": 560,
      "y": 360,
      "data": {
        "elaboration": {
          "definition": "La ricerca deliberata di domande: esaminare le premesse, raccogliere evidenze e rivedere le proprie credenze con indagine, invece di accettare risposte passivamente."
        }
      }
    },
    {
      "id": "n6",
      "label": "Mente",
      "x": 95,
      "y": 110,
      "data": {
        "elaboration": {
          "definition": "L'insieme delle capacità cognitive—attenzione, memoria di lavoro, memoria a lungo termine, ragionamento—che rendono possibili il pensiero e la comprensione."
        }
      }
    },
    {
      "id": "n7",
      "label": "Consumo passivo",
      "x": 120,
      "y": 356,
      "data": {
        "elaboration": {
          "definition": "Assorbire informazioni senza elaborarle: scorrere titoli, feed o video senza integrarli in un modello personale di come funzionano le cose."
        }
      }
    }
  ],
