{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/lib/utils.ts",
    "src/plugins/panel.css",
    "site/index.html",
    "electron/preload.cts",
    "packages/plugin/src/guard.ts",
    "packages/plugin/src/worker.ts",
    "packages/plugin/src/action-relay.ts",
    "packages/plugin/src/panel.ts",
    "packages/plugin/src/react.ts"
  ],
  "workspaces": { "patterns": ["packages/plugin/example"] },
  "ignoreDependencies": ["shadcn"],
  "rules": {
    "unused-exports": "warn",
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn"
  },
  "duplicates": { "threshold": 0 },
  "boundaries": {
    "zones": [
      { "name": "host", "patterns": ["src/**", "electron/**"] },
      { "name": "schema", "patterns": ["packages/schema/**"] },
      { "name": "errors", "patterns": ["packages/errors/**"] },
      { "name": "shared", "patterns": ["packages/**"] },
      { "name": "plugins", "patterns": ["plugins/**"] }
    ],
    "rules": [
      { "from": "schema", "allow": ["errors"] },
      { "from": "errors", "allow": [] },
      { "from": "shared", "allow": ["schema", "errors"] },
      { "from": "plugins", "allow": ["schema", "errors", "shared"] }
    ]
  },
  "rulePacks": ["fallow-rules.json"]
}
