{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/lib/utils.ts",
    "src/plugins/panel.css",
    "site/index.html",
    "electron/preload.cts",
    "packages/plugin/src/guard.ts",
    "packages/plugin/src/worker.ts",
    "packages/plugin/src/action-relay.ts",
    "packages/plugin/src/panel.ts",
    "packages/plugin/src/react.ts"
  ],
  "ignorePatterns": ["dist-electron/**"],
  "workspaces": {
    "patterns": ["packages/plugin/example"]
  },
  "ignoreDependencies": ["shadcn"],
  "rules": {
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn"
  },
  "health": {
    "ignore": ["scripts/**", "e2e/**"]
  },
  "boundaries": {
    "zones": [
      {
        "name": "host",
        "patterns": ["src/**", "electron/**"]
      },
      {
        "name": "app-shared",
        "patterns": ["shared/**"]
      },
      {
        "name": "plugin-tests",
        "patterns": ["plugins/**/*.test.{ts,tsx}"]
      },
      {
        "name": "plugins",
        "patterns": ["plugins/**", "packages/plugin/example/**"]
      },
      {
        "name": "schema",
        "patterns": ["packages/schema/**"]
      },
      {
        "name": "errors",
        "patterns": ["packages/errors/**"]
      },
      {
        "name": "sdk",
        "patterns": ["packages/plugin/**", "packages/ui/**"]
      },
      {
        "name": "shared",
        "patterns": ["packages/**"]
      }
    ],
    "rules": [
      {
        "from": "host",
        "allow": ["app-shared", "schema", "errors", "sdk", "shared"]
      },
      {
        "from": "app-shared",
        "allow": ["schema", "errors", "sdk", "shared"]
      },
      {
        "from": "schema",
        "allow": ["errors"]
      },
      {
        "from": "errors",
        "allow": []
      },
      {
        "from": "sdk",
        "allow": ["schema", "errors", "shared"]
      },
      {
        "from": "shared",
        "allow": ["schema", "errors", "sdk"]
      },
      {
        "from": "plugins",
        "allow": ["schema", "errors", "sdk"]
      },
      {
        "from": "plugin-tests",
        "allow": ["plugins", "schema", "errors", "sdk", "shared"]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["scripts/**", "e2e/**", "site/**", "index.html", "vite.config.ts"]
    }
  },
  "rulePacks": ["fallow-rules.json"]
}
