{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@nesso-how/errors": ["./packages/errors/src/index.ts"],
      "@nesso-how/schema": ["./packages/schema/src/index.ts"],
      "@nesso-how/i18n": ["./packages/i18n/src/index.ts"]
    }
  },
  "include": ["packages/plugin/src/index.ts", "packages/plugin/src/runtime.ts", "packages/plugin/src/package.ts"]
}
