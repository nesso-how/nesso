    {
      "@id": "urn:nesso:example:curiosity",
      "rdfs:label": "Curiosity",
      "rdfs:comment": "The **pull** toward what we do not yet *know*.",
      "sparks": {
        "@id": "urn:nesso:example:questions"
      }
    },
    {
      "@id": "urn:nesso:example:questions",
      "rdfs:label": "Questions",
      "rdfs:comment": "Open **problems** that give attention a *direction*.",
      "guide": {
        "@id": "urn:nesso:example:exploration"
      }
    },
    {
      "@id": "urn:nesso:example:exploration",
      "rdfs:label": "Exploration",
      "rdfs:comment": "**Trying** ideas out, comparing sources and following *leads*.",
      "reveals": {
        "@id": "urn:nesso:example:connections"
      }
    },
    {
      "@id": "urn:nesso:example:connections",
      "rdfs:label": "Connections",
      "rdfs:comment": "Links between *new ideas* and what we already **know**.",
      "deepen": {
        "@id": "urn:nesso:example:understanding"
      }
    },
    {
      "@id": "urn:nesso:example:understanding",
      "rdfs:label": "Understanding",
      "rdfs:comment": "Being able to **explain** how ideas relate, recognize patterns and apply them in new situations. It grows through exploration, practice and *feedback*.",
      "enables": [
        {
          "@id": "urn:nesso:example:explaining"
        },
        {
          "@id": "urn:nesso:example:solving"
        },
        {
          "@id": "urn:nesso:example:transfer"
        }
      ]
    },
    {
      "@id": "urn:nesso:example:retrieval",
      "rdfs:label": "Retrieval practice",
      "rdfs:comment": "**Recalling** an idea from memory instead of *rereading* it.",
      "strengthens": {
        "@id": "urn:nesso:example:memory"
      }
    },
    {
      "@id": "urn:nesso:example:spacing",
      "rdfs:label": "Spaced repetition",
      "rdfs:comment": "Reviewing at growing **intervals**, just before *forgetting*.",
      "strengthens": {
        "@id": "urn:nesso:example:memory"
      }
    },
    {
      "@id": "urn:nesso:example:interleaving",
      "rdfs:label": "Interleaving",
      "rdfs:comment": "**Mixing** related topics so each one is easier to *tell apart*.",
      "strengthens": {
        "@id": "urn:nesso:example:memory"
      }
    },
    {
      "@id": "urn:nesso:example:memory",
      "rdfs:label": "Long-term memory",
      "rdfs:comment": "Knowledge that stays *available* long after it was first **learned**.",
      "supports": {
        "@id": "urn:nesso:example:understanding"
      }
    },
    {
      "@id": "urn:nesso:example:feedback",
      "rdfs:label": "Feedback",
      "rdfs:comment": "Signals that show where an explanation **holds** and where it *breaks*.",
      "refines": {
        "@id": "urn:nesso:example:understanding"
      }
    },
    {
      "@id": "urn:nesso:example:explaining",
      "rdfs:label": "Explaining",
      "rdfs:comment": "Putting an idea into **your own words** for *someone else*."
    },
    {
      "@id": "urn:nesso:example:solving",
      "rdfs:label": "Problem solving",
      "rdfs:comment": "Using what you **know** to work through something *unfamiliar*."
    },
    {
      "@id": "urn:nesso:example:transfer",
      "rdfs:label": "Transfer",
      "rdfs:comment": "Applying an idea in a context *different* from where it was **learned**."
    },
