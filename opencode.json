{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "mcp": {
    "fallow": {
      "type": "local",
      "command": ["npx", "-y", "-p", "fallow", "fallow-mcp"]
    },
    "nesso": {
      "type": "local",
      "command": ["node", "packages/mcp/dist/index.js"]
    },
    "tauri": {
      "type": "local",
      "command": ["npx", "-y", "@hypothesi/tauri-mcp-server"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "agent": {
    "architect": {
      "mode": "primary",
      "permission": {
        "external_directory": "ask",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git tag*": "ask",
          "gh pr *": "ask"
        }
      }
    }
  },
  "plugin": ["@atlante/opencode@0.1.20"]
}
