{
  "name": "@nesso-how/plugin",
  "version": "1.0.0-beta.18",
  "description": "Types, validation, and asynchronous clients for isolated Nesso plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesso-how/nesso.git",
    "directory": "packages/plugin"
  },
  "files": [
    "dist",
    "example"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "browser": "./src/index.ts",
      "default": "./dist/node/index.js"
    },
    "./runtime": {
      "types": "./dist/node/runtime.d.ts",
      "browser": "./src/runtime.ts",
      "default": "./dist/node/runtime.js"
    },
    "./package": {
      "types": "./dist/node/package.d.ts",
      "browser": "./src/package.ts",
      "default": "./dist/node/package.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./package": {
        "types": "./dist/package.d.ts",
        "default": "./dist/package.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p ../../tsconfig.plugin.json && tsdown && tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "semver": "^7.8.5",
    "validate-npm-package-name": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nesso-how/core": "workspace:*",
    "@nesso-how/errors": "workspace:*",
    "@nesso-how/i18n": "workspace:*",
    "@nesso-how/schema": "workspace:*",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "es-module-lexer": "^3.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1"
  }
}
