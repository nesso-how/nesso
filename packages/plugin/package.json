{
  "name": "@nesso-how/plugin",
  "version": "0.5.0",
  "description": "Types, validation, and asynchronous clients for isolated Nesso plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesso-how/nesso.git",
    "directory": "packages/plugin"
  },
  "type": "module",
  "files": ["dist", "example"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./package": "./src/package.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./runtime": { "types": "./dist/runtime.d.ts", "default": "./dist/runtime.js" },
      "./package": { "types": "./dist/package.d.ts", "default": "./dist/package.js" }
    }
  },
  "scripts": {
    "build": "tsc -p ../../tsconfig.plugin.json && tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "semver": "^7.8.5",
    "validate-npm-package-name": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nesso-how/errors": "workspace:*",
    "@nesso-how/i18n": "workspace:*",
    "@nesso-how/schema": "workspace:*",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "es-module-lexer": "^3.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1"
  }
}
