{
  "name": "@nesso-how/plugin-example",
  "version": "0.3.1",
  "description": "Uppercase concept labels in the invoked Nesso view",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesso-how/nesso.git",
    "directory": "packages/plugin/example"
  },
  "type": "module",
  "keywords": ["nesso-plugin"],
  "files": ["dist", "src", "tsconfig.json"],
  "scripts": {
    "check": "tsc",
    "build": "npm run check && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@nesso-how/plugin": "0.3.1",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  },
  "nesso": {
    "apiVersion": 1,
    "kind": "actions",
    "entry": "dist/index.js",
    "writes": ["concept.label"],
    "capabilities": []
  },
  "i18n": {
    "metadata": {
      "name": { "en": "Uppercase labels" },
      "description": { "en": "Uppercase concept labels in the invoked view." },
      "documentation": { "en": "Changes the labels of concepts in the invoked view in one undoable transaction. Concepts shared with other views change there too." }
    }
  }
}
