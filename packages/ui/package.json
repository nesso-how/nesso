{
  "name": "@nesso-how/ui",
  "version": "1.0.0-alpha.31",
  "description": "Reusable React primitives and shared styles for Nesso, usable in the app and in isolated plugin panels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nesso-how/nesso.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsdown": "^0.23.1"
  }
}
