{
  "name": "nesso",
  "private": true,
  "version": "1.0.0-alpha.26",
  "description": "A minimal knowledge graph app",
  "license": "MIT",
  "homepage": "https://nesso.how",
  "desktopName": "dev.nesso.desktop",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "postinstall": "pnpm build:packages",
    "dev": "pnpm build:plugins && vite",
    "build": "pnpm build:packages && pnpm build:plugins && tsc -b && vite build",
    "build:packages": "pnpm --filter \"./packages/*\" -r --if-present build",
    "build:plugins": "node scripts/build-plugins.ts",
    "lint": "oxlint",
    "analyze": "fallow",
    "test": "pnpm build:packages && tsc -p tsconfig.test.json && node --test \"**/*.test.ts\"",
    "test:unit": "pnpm build:packages && tsc -p tsconfig.test.json && node --test \"**/!(*.integration).test.ts\"",
    "test:integration": "pnpm build:packages && tsc -p tsconfig.test.json && node --test \"**/*.integration.test.ts\"",
    "test:plugin-runtime": "pnpm build && node scripts/test-plugin-runtime.ts",
    "test:desktop": "node scripts/test-desktop.ts",
    "preview": "vite preview",
    "site:dev": "tsc -b packages/i18n && vite --config site/vite.config.ts",
    "site:build": "tsc -b packages/i18n && vite build --config site/vite.config.ts",
    "site:preview": "tsc -b packages/i18n && vite preview --config site/vite.config.ts",
    "desktop": "pnpm build && electron .",
    "desktop:dev": "tsc -b tsconfig.electron.json && electron . --dev",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --universal --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --x64 --publish never",
    "release": "node scripts/release.ts",
    "release:plugin": "node scripts/release-plugin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.76",
    "@ai-sdk/google": "^4.0.92",
    "@ai-sdk/openai": "^4.0.89",
    "@ai-sdk/openai-compatible": "^3.0.66",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nesso-how/ai": "workspace:*",
    "@nesso-how/concept-map": "workspace:*",
    "@nesso-how/errors": "workspace:*",
    "@nesso-how/i18n": "workspace:*",
    "@nesso-how/plugin": "workspace:*",
    "@nesso-how/schema": "workspace:*",
    "@nesso-how/ui": "workspace:*",
    "ai": "^7.0.133",
    "cn": "^0.4.0",
    "electron-updater": "^6.8.9",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "npm-registry-fetch": "^20.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "validate-npm-package-name": "^8.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.nesso.desktop",
    "productName": "Nesso",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*.{js,cjs,json}"
    ],
    "publish": {
      "provider": "github",
      "owner": "nesso-how",
      "repo": "nesso"
    },
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "public/icon-512.png"
    },
    "linux": {
      "icon": "public/icon-512.png",
      "category": "Office",
      "syncDesktopName": true,
      "maintainer": "Nesso contributors"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/npm-registry-fetch": "^8.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/semver": "^7.8.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fallow": "3.32.0",
    "git-cliff": "2.14.2",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
