{
  "name": "nesso-min",
  "private": true,
  "version": "0.0.0",
  "description": "A minimal knowledge graph app",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "desktop": "pnpm build && electron .",
    "desktop:dev": "tsc -p tsconfig.electron.json && electron . --dev",
    "dist:mac": "pnpm build && electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nesso/export": "workspace:*",
    "@nesso/graph": "workspace:*",
    "@nesso/plugin": "workspace:*",
    "@nesso/schema": "workspace:*",
    "@nesso/vocab": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "app.nesso.min",
    "productName": "Nesso",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*.js", "!node_modules/**/*"],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
