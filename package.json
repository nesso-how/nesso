{
  "name": "nesso",
  "private": true,
  "version": "1.0.0-alpha.8",
  "description": "A minimal knowledge graph app",
  "homepage": "https://nesso.how",
  "desktopName": "dev.nesso.desktop",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "analyze": "fallow",
    "test": "tsc -b packages/ai && node --test",
    "preview": "vite preview",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "desktop": "pnpm build && electron .",
    "desktop:dev": "tsc -b tsconfig.electron.json && electron . --dev",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --x64 --publish never",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.76",
    "@ai-sdk/google": "^4.0.92",
    "@ai-sdk/openai": "^4.0.89",
    "@ai-sdk/openai-compatible": "^3.0.66",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nesso/ai": "workspace:*",
    "@nesso/export": "workspace:*",
    "@nesso/concept-map": "workspace:*",
    "@nesso/i18n": "workspace:*",
    "@nesso/import": "workspace:*",
    "@nesso/plugin": "workspace:*",
    "@nesso/schema": "workspace:*",
    "@nesso/kernel": "workspace:*",
    "@nesso/ui": "workspace:*",
    "@nesso/base-vocab": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.133",
    "cn": "^0.4.0",
    "electron-updater": "^6.8.9",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.nesso.desktop",
    "productName": "Nesso",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*.{js,cjs}"],
    "publish": { "provider": "github", "owner": "nesso-how", "repo": "nesso" },
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "public/icon-512.png"
    },
    "linux": {
      "icon": "public/icon-512.png",
      "category": "Office",
      "syncDesktopName": true,
      "maintainer": "Nesso contributors"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fallow": "3.32.0",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
